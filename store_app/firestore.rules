rules_version = '2';

// قواعد حماية متجر La Casa 3D.
// انسخ هذا الملف كله والصقه بـ Firebase ← Firestore ← Rules، واضغط Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // المدير: حساب عنده document بـ admins/{uid}. ينضاف يدوياً من موقع Firebase.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function validCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name', 'phone', 'address', 'notes'])
        && c.keys().hasAll(['name', 'phone'])
        && isText(c.name, 1, 100)
        && isText(c.phone, 7, 20)
        && (!('address' in c) || isText(c.address, 0, 300))
        && (!('notes' in c) || isText(c.notes, 0, 500));
    }

    // الزبون يكدر يسوي طلب جديد بس، بحالة "new"، وبشكل صحيح.
    // إذا الطلب مربوط بحساب، لازم يكون حسابه هو.
    function validNewOrder(o) {
      return o.keys().hasOnly(['customer', 'items', 'total', 'status', 'createdAt',
                               'deliveryDay', 'pickupMethod', 'userId', 'pushToken'])
        && o.keys().hasAll(['customer', 'items', 'total', 'status', 'createdAt',
                            'deliveryDay', 'pickupMethod'])
        && validCustomer(o.customer)
        && o.items is list && o.items.size() >= 1 && o.items.size() <= 50
        && o.total is int && o.total > 0 && o.total <= 100000000
        && o.status == 'new'
        && o.createdAt == request.time
        && o.deliveryDay in ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة']
        && o.pickupMethod in ['delivery', 'pickup']
        && (!('userId' in o) || (request.auth != null && o.userId == request.auth.uid))
        // توكن تليفون الزبون حتى السيرفر يرسله إشعار بحالة الطلب.
        && (!('pushToken' in o) || isText(o.pushToken, 1, 4096));
    }

    // joinedAt: وكت أول دخول للحساب (للإحصائيات). ينكتب مرة وحدة وما يتغير.
    function validProfile(p) {
      return p.keys().hasOnly(['name', 'phone', 'address', 'joinedAt'])
        && isText(p.get('name', ''), 0, 100)
        && isText(p.get('phone', ''), 0, 20)
        && isText(p.get('address', ''), 0, 300)
        && (!('joinedAt' in p)
            || p.joinedAt == (resource != null && 'joinedAt' in resource.data
                              ? resource.data.joinedAt : request.time));
    }

    match /admins/{uid} {
      // كل واحد يكدر يشوف إذا هو مدير. محد يكدر يضيف مدير من التطبيق.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // محتوى المتجر: الكل يقرا، المدير بس يعدل.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // معلومات الزبون: بس صاحب الحساب يشوفها ويعدلها. المدير يحسبهم بالإحصائيات.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && validProfile(request.resource.data);
      // الزبون يكدر يحذف حسابه ومعلوماته من التطبيق.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // زوار التطبيق: كل جهاز يسجل رقم عشوائي ووكت آخر فتحة. المدير بس يشوفهم.
    match /devices/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^[A-Za-z0-9]{16,40}$')
        && request.resource.data.keys().hasOnly(['firstSeen', 'lastSeen', 'platform'])
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time
        && request.resource.data.platform in ['android', 'ios', 'other'];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
    }

    // موبايلات صاحب المتجر لإشعار الطلبات الجديدة. السيرفر يقراها بمفتاح الخدمة.
    match /adminDevices/{token} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // الطلب المباشر من التطبيق (النسخ القديمة). النسخة الجديدة تطلب عن طريق السيرفر
    // (/api/orders) اللي يحسب الأسعار والخصومات بنفسه. صاحب المتجر يكدر يوقف الطريق القديم
    // من لوحة التحكم (settings/orders.legacyClientOrders = false) بعد ما الكل يحدّث التطبيق.
    function legacyOrdersAllowed() {
      return !exists(/databases/$(database)/documents/settings/orders)
        || get(/databases/$(database)/documents/settings/orders).data.get('legacyClientOrders', true) == true;
    }

    match /orders/{orderId} {
      allow create: if legacyOrdersAllowed() && validNewOrder(request.resource.data);
      // الزبون يشوف طلباته بس، والمدير يشوف الكل.
      allow read: if isAdmin()
        || (request.auth != null && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isAdmin();
      // المدير يغير الحالة بس. طلب السيرفر الملغي ما يرجع (النقاط والكوبون رجعت للزبون).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'confirmed', 'delivering', 'done', 'cancelled']
        && !(resource.data.get('pricedBy', '') == 'server' && resource.data.status == 'cancelled');
    }

    // ───── الكوبونات والولاء والدعوات ─────
    // الأرصدة واستعمال الكوبونات والدعوات يكتبها السيرفر بس (بمفتاح الخدمة)،
    // حتى محد يكدر يضيف نقاط لنفسه أو يصفّر عداد كوبون من التطبيق.

    function validCoupon(c) {
      return c.keys().hasOnly(['description', 'type', 'value', 'minSubtotal', 'maxDiscount', 'startsAt', 'endsAt',
                               'usageLimit', 'perUserLimit', 'usedCount', 'active', 'assignedTo', 'firstOrderOnly',
                               'createdAt', 'updatedAt'])
        // freeDelivery: توصيل مجاني (يشيل أجور التوصيل بس، فقيمته 0).
        && c.type in ['percent', 'fixed', 'freeDelivery']
        && c.value is int && c.value >= 0
        && (c.type == 'freeDelivery' || c.value > 0)
        && (c.type != 'percent' || c.value <= 100)
        && c.get('minSubtotal', 0) is int && c.get('minSubtotal', 0) >= 0
        && c.get('maxDiscount', 0) is int && c.get('maxDiscount', 0) >= 0
        && c.get('usageLimit', 0) is int && c.get('usageLimit', 0) >= 0
        && c.get('perUserLimit', 1) is int && c.get('perUserLimit', 1) >= 0
        && c.active is bool
        && isText(c.get('description', ''), 0, 200)
        && isText(c.get('assignedTo', ''), 0, 128)
        && (!('startsAt' in c) || c.startsAt is timestamp)
        && (!('endsAt' in c) || c.endsAt is timestamp);
    }

    match /coupons/{code} {
      // الزبون يشوف بس الكوبونات المخصصة إله (بمحفظته). الكوبونات العامة سرية، وتنفحص بالسيرفر.
      allow read: if isAdmin()
        || (request.auth != null && resource.data.get('assignedTo', '') == request.auth.uid);
      allow create: if isAdmin() && code.matches('^[A-Z0-9_-]{3,24}$')
        && validCoupon(request.resource.data) && request.resource.data.get('usedCount', 0) == 0;
      // عداد الاستعمال يغيره السيرفر بس.
      allow update: if isAdmin() && validCoupon(request.resource.data)
        && request.resource.data.get('usedCount', 0) == resource.data.get('usedCount', 0);
      // المدير يكدر يحذف الكوبون؛ الطلبات اللي استعملته تبقى (الرمز محفوظ بالطلب).
      allow delete: if isAdmin();

      match /uses/{who} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /wallets/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;

      match /ledger/{entry} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow write: if false;
      }
    }

    match /referrals/{uid} {
      allow read: if isAdmin() || (request.auth != null
        && (request.auth.uid == uid || resource.data.referrerUid == request.auth.uid));
      allow write: if false;
    }

    match /referralCodes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // العروض الذكية: "اللي يطلب كذا تبينله كذا". الكل يقرا، المدير بس يعدل.
    match /recommendationRules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

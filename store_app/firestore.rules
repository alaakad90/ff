rules_version = '2';

// قواعد حماية متجر La Casa 3D.
// انسخ هذا الملف كله والصقه بـ Firebase ← Firestore ← Rules، واضغط Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // المدير: حساب عنده document بـ admins/{uid}. ينضاف يدوياً من موقع Firebase.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function validCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name', 'phone', 'address', 'notes'])
        && c.keys().hasAll(['name', 'phone'])
        && isText(c.name, 1, 100)
        && isText(c.phone, 7, 20)
        && (!('address' in c) || isText(c.address, 0, 300))
        && (!('notes' in c) || isText(c.notes, 0, 500));
    }

    // الزبون يكدر يسوي طلب جديد بس، بحالة "new"، وبشكل صحيح.
    // إذا الطلب مربوط بحساب، لازم يكون حسابه هو.
    function validNewOrder(o) {
      return o.keys().hasOnly(['customer', 'items', 'total', 'status', 'createdAt',
                               'deliveryDay', 'pickupMethod', 'userId'])
        && o.keys().hasAll(['customer', 'items', 'total', 'status', 'createdAt',
                            'deliveryDay', 'pickupMethod'])
        && validCustomer(o.customer)
        && o.items is list && o.items.size() >= 1 && o.items.size() <= 50
        && o.total is int && o.total > 0 && o.total <= 100000000
        && o.status == 'new'
        && o.createdAt == request.time
        && o.deliveryDay in ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة']
        && o.pickupMethod in ['delivery', 'pickup']
        && (!('userId' in o) || (request.auth != null && o.userId == request.auth.uid));
    }

    function validProfile(p) {
      return p.keys().hasOnly(['name', 'phone', 'address'])
        && isText(p.get('name', ''), 0, 100)
        && isText(p.get('phone', ''), 0, 20)
        && isText(p.get('address', ''), 0, 300);
    }

    match /admins/{uid} {
      // كل واحد يكدر يشوف إذا هو مدير. محد يكدر يضيف مدير من التطبيق.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // محتوى المتجر: الكل يقرا، المدير بس يعدل.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // معلومات الزبون: بس صاحب الحساب يشوفها ويعدلها.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && validProfile(request.resource.data);
    }

    match /orders/{orderId} {
      allow create: if validNewOrder(request.resource.data);
      // الزبون يشوف طلباته بس، والمدير يشوف الكل.
      allow read: if isAdmin()
        || (request.auth != null && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isAdmin();
      // المدير يغير الحالة بس.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'confirmed', 'delivering', 'done', 'cancelled'];
    }
  }
}

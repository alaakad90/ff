  "type": "module",
  "description": "اختبارات السيرفر وقواعد Firestore على محاكي Firestore الحقيقي (Java).",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-lacasa \"node --test --test-concurrency=1 *.test.js\"",
